# Set this only when opening the laptop UI via localhost and connecting a phone
# on the same Wi-Fi. Use your laptop's IPv4 address, e.g. 192.168.1.25.
VITE_LAN_HOST=192.168.1.25

# Required for Netlify: use your Render backend URL (without a trailing slash).
# VITE_API_URL=https://your-render-service.onrender.com
