# Create a Web application OAuth client in Google Cloud Console, then copy this
# file to .env and set the values. Never commit the real .env file.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# This must exactly match an Authorized redirect URI on the OAuth client.
# For local development, register: http://localhost:5000/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback
